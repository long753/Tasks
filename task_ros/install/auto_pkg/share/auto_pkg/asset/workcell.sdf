<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="workcell">
    <!-- 仿真系统、光照与渲染。 -->
    <gravity>0 0 -9.81</gravity>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <!-- 场地地板与边墙；建图范围读取 floor_collision 的尺寸。 -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box><size>8 6 0.1</size></box>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box><size>8 6 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.32 0.34 0.36 1</ambient>
            <diffuse>0.48 0.50 0.53 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="boundary_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_collision">
          <pose>0 3 0.3 0 0 0</pose>
          <geometry><box><size>8 0.1 0.6</size></box></geometry>
        </collision>
        <collision name="south_collision">
          <pose>0 -3 0.3 0 0 0</pose>
          <geometry><box><size>8 0.1 0.6</size></box></geometry>
        </collision>
        <collision name="east_collision">
          <pose>4 0 0.3 0 0 0</pose>
          <geometry><box><size>0.1 6 0.6</size></box></geometry>
        </collision>
        <collision name="west_collision">
          <pose>-4 0 0.3 0 0 0</pose>
          <geometry><box><size>0.1 6 0.6</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 3 0.3 0 0 0</pose>
          <geometry><box><size>8 0.1 0.6</size></box></geometry>
          <material><diffuse>0.20 0.23 0.26 1</diffuse></material>
        </visual>
        <visual name="south_visual">
          <pose>0 -3 0.3 0 0 0</pose>
          <geometry><box><size>8 0.1 0.6</size></box></geometry>
          <material><diffuse>0.20 0.23 0.26 1</diffuse></material>
        </visual>
        <visual name="east_visual">
          <pose>4 0 0.3 0 0 0</pose>
          <geometry><box><size>0.1 6 0.6</size></box></geometry>
          <material><diffuse>0.20 0.23 0.26 1</diffuse></material>
        </visual>
        <visual name="west_visual">
          <pose>-4 0 0.3 0 0 0</pose>
          <geometry><box><size>0.1 6 0.6</size></box></geometry>
          <material><diffuse>0.20 0.23 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 起点 pose 是机器人出生与 AMCL 初始化的共同来源；标记本身仅作视觉参考。 -->
    <model name="start_marker">
      <static>true</static>
      <pose>-3 2 0 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>0.28</radius><length>0.006</length></cylinder></geometry>
          <material><diffuse>0.10 0.55 0.95 0.8</diffuse><emissive>0.02 0.12 0.24 1</emissive></material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>
    <model name="dock_marker">
      <static>true</static>
      <pose>3.0 -1.3 0 0 0 -1.5707963267948966</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.006</length></cylinder></geometry>
          <material><diffuse>0.15 0.85 0.35 0.8</diffuse><emissive>0.03 0.22 0.06 1</emissive></material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <!-- 静态障碍；南北两侧保留绕行通道。 -->
    <model name="static_obstacle">
      <static>true</static>
      <pose>-1.6 0 0 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>0.4 1.5 0.6</size></box></geometry>
          <material><diffuse>0.88 0.45 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Staggered wall extensions narrow opposite sides without closing either route. -->
    <model name="north_offset_barrier">
      <static>true</static>
      <pose>-2.2 2.35 0.36 0 0 0</pose>
      <link name="barrier_link">
        <collision name="collision">
          <geometry><box><size>0.4 1.2 0.72</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.2 0.72</size></box></geometry>
          <material><diffuse>0.22 0.42 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_offset_barrier">
      <static>true</static>
      <pose>1.08 -2.3 0.36 0 0 0</pose>
      <link name="barrier_link">
        <collision name="collision">
          <geometry><box><size>0.4 1.3 0.72</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.3 0.72</size></box></geometry>
          <material><diffuse>0.22 0.42 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 作业区：工作台、托盘和待抓取物块。 -->
    <model name="worktable">
      <static>true</static>
      <!-- 桌面中心作为模型原点；顺时针转 90°，北侧留作机器人作业区。 -->
      <pose>3.0 -2.2 0 0 0 -1.5707963267948966</pose>
      <link name="table_link">
        <!-- 北侧近边 y = -1.90，桌面顶部 z = 0.72。以下位置均在桌台局部坐标系中。 -->
        <collision name="tabletop_collision">
          <pose>0 0 0.695 0 0 0</pose>
          <geometry><box><size>0.6 0.9 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="tabletop_visual">
          <pose>0 0 0.695 0 0 0</pose>
          <geometry><box><size>0.6 0.9 0.05</size></box></geometry>
          <material><diffuse>0.38 0.24 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_northwest_collision">
          <pose>-0.25 0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
        </collision>
        <collision name="leg_northeast_collision">
          <pose>0.25 0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
        </collision>
        <collision name="leg_southwest_collision">
          <pose>-0.25 -0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
        </collision>
        <collision name="leg_southeast_collision">
          <pose>0.25 -0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
        </collision>
        <visual name="leg_northwest_visual">
          <pose>-0.25 0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
          <material><diffuse>0.18 0.16 0.14 1</diffuse></material>
        </visual>
        <visual name="leg_northeast_visual">
          <pose>0.25 0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
          <material><diffuse>0.18 0.16 0.14 1</diffuse></material>
        </visual>
        <visual name="leg_southwest_visual">
          <pose>-0.25 -0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
          <material><diffuse>0.18 0.16 0.14 1</diffuse></material>
        </visual>
        <visual name="leg_southeast_visual">
          <pose>0.25 -0.36 0.335 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.67</size></box></geometry>
          <material><diffuse>0.18 0.16 0.14 1</diffuse></material>
        </visual>

        <!-- Tray floor top is z = 0.735; 10 mm walls leave a 180 mm square interior. -->
        <!-- 托盘靠近新的北侧作业边，与物块并排放置。 -->
        <collision name="tray_floor_collision">
          <pose>-0.18 0.19 0.7275 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.015</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="tray_floor_visual">
          <pose>-0.18 0.19 0.7275 0 0 0</pose>
          <geometry><box><size>0.2 0.2 0.015</size></box></geometry>
          <material><diffuse>0.12 0.32 0.65 1</diffuse></material>
        </visual>
        <collision name="tray_west_wall_collision">
          <pose>-0.275 0.19 0.7485 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.027</size></box></geometry>
        </collision>
        <collision name="tray_east_wall_collision">
          <pose>-0.085 0.19 0.7485 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.027</size></box></geometry>
        </collision>
        <collision name="tray_south_wall_collision">
          <pose>-0.18 0.095 0.7485 0 0 0</pose>
          <geometry><box><size>0.2 0.01 0.027</size></box></geometry>
        </collision>
        <collision name="tray_north_wall_collision">
          <pose>-0.18 0.285 0.7485 0 0 0</pose>
          <geometry><box><size>0.2 0.01 0.027</size></box></geometry>
        </collision>
        <visual name="tray_west_wall_visual">
          <pose>-0.275 0.19 0.7485 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.027</size></box></geometry>
          <material><diffuse>0.12 0.32 0.65 1</diffuse></material>
        </visual>
        <visual name="tray_east_wall_visual">
          <pose>-0.085 0.19 0.7485 0 0 0</pose>
          <geometry><box><size>0.01 0.2 0.027</size></box></geometry>
          <material><diffuse>0.12 0.32 0.65 1</diffuse></material>
        </visual>
        <visual name="tray_south_wall_visual">
          <pose>-0.18 0.095 0.7485 0 0 0</pose>
          <geometry><box><size>0.2 0.01 0.027</size></box></geometry>
          <material><diffuse>0.12 0.32 0.65 1</diffuse></material>
        </visual>
        <visual name="tray_north_wall_visual">
          <pose>-0.18 0.285 0.7485 0 0 0</pose>
          <geometry><box><size>0.2 0.01 0.027</size></box></geometry>
          <material><diffuse>0.12 0.32 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="target_block">
      <pose>2.81 -2.02 0.745 0 0 -1.5707963267948966</pose>
      <static>false</static>
      <link name="block_link">
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>0.00001875</ixx><iyy>0.00001875</iyy><izz>0.00001875</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><diffuse>0.96 0.76 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
